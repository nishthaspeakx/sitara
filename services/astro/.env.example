# sitara-astro — shape only, never real values
PORT=8003
# Swiss Ephemeris data path (licence: astro.com — see playbook §0.1).
# Relative paths resolve against the service root; the committed default works
# out of the box. Engine falls back to Moshier (recorded in data_revision) if absent.
SWISSEPH_DATA_PATH=data/swisseph
