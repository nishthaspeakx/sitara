  "date_expression_patterns": {
    "$comment": "CL-002b. A calendar date is not an astrological number. Only a number INSIDE one of these is excluded from the weak+number trigger; a bare ordinal never is, so '4th house' and 'चौथे भाव' still fire.",
    "en": "\\b(\\d{1,2}\\s+(?:january|february|march|april|may|june|july|august|september|october|november|december)\\s+\\d{4}|(?:january|february|march|april|may|june|july|august|september|october|november|december)\\s+\\d{1,2},?\\s+\\d{4}|\\d{4}-\\d{2}-\\d{2}|\\d{1,2}/\\d{1,2}/\\d{2,4})\\b",
    "hi": "(\\d{1,2}\\s*(?:जनवरी|फ़रवरी|फरवरी|मार्च|अप्रैल|मई|जून|जुलाई|अगस्त|सितंबर|अक्टूबर|नवंबर|दिसंबर)\\s*\\d{4}|\\d{4}-\\d{2}-\\d{2})",
    "hi-Latn": "\\b(\\d{1,2}\\s+(?:january|february|march|april|may|june|july|august|september|october|november|december|janvari|farvari|march|aprail|jun|julai|agast|sitambar|aktubar|navambar|disambar)\\s+\\d{4}|\\d{4}-\\d{2}-\\d{2})\\b"
  },
