# sitara-api — shape only, never real values (keys live in .env, git-ignored)
PORT=8001
MONGODB_URI=mongodb://localhost:27018/sitara
REDIS_URL=redis://localhost:6379/0

# Firebase Admin SDK (§33.2/§34.5 — server-side ID-token verification only)
# Service-account JSON lives at services/api/.secrets/ (git-ignored), never in the repo.
GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=your-project-id

# --- §5.2 Layer B panchang providers ---------------------------------------
# Fill these from the vendor dashboards. A BLANK key is not an error: the
# provider then behaves as "down" and the §8 degradation ladder runs (that is
# the M3 kill-the-key acceptance). Never commit real values.

# DivineAPI — PRIMARY for panchang/muhurat/festivals (§32.2)
DIVINEAPI_BASE_URL=https://astroapi-4.divineapi.com
# DIVINE_API_KEY is accepted as an alias (it is what their dashboard calls it).
DIVINEAPI_API_KEY=
# Optional — some tiers authenticate with the api_key alone.
DIVINEAPI_AUTH_TOKEN=
DIVINEAPI_TIMEOUT_SECONDS=4.0
# Endpoint paths are overridable so a correction found while recording
# fixtures needs no code change. Leave blank to use the adapter defaults.
# REQUIRED until the real paths are known: every guessed path 404s against the
# live host. Copy them from the DivineAPI dashboard; no code change needed.
DIVINEAPI_PATH_PANCHANG=
DIVINEAPI_PATH_DAY_TIMINGS=
DIVINEAPI_PATH_MUHURAT=

# Prokerala — CROSS-CHECK ORACLE (OAuth2 client credentials).
# Its ToS forbids it being the system of record, so nothing it returns is ever
# cached (§5.2) and it never wins a disagreement (§32.2).
PROKERALA_BASE_URL=https://api.prokerala.com
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
PROKERALA_TIMEOUT_SECONDS=4.0
# Verified live: /token, /v2/astrology/panchang, /v2/astrology/choghadiya,
# /v2/astrology/auspicious-period. A SANDBOX account accepts only January 1st.
PROKERALA_PATH_TOKEN=
PROKERALA_PATH_PANCHANG=
PROKERALA_PATH_DAY_TIMINGS=
PROKERALA_PATH_MUHURAT=

# §8 circuit breaker: fail fast after 5 errors/30s, half-open probe after 60s.
PANCHANG_BREAKER_ERRORS=5
PANCHANG_BREAKER_WINDOW_SECONDS=30
PANCHANG_BREAKER_HALF_OPEN_SECONDS=60

# §7.2 cache TTLs.
PANCHANG_CACHE_TTL_DAYS=90
MUHURAT_CACHE_TTL_DAYS=30
TRANSIT_CACHE_TTL_DAYS=400

# Fixture recording — set to 1 ONLY while recording. CI never sets it.
SITARA_RECORD_FIXTURES=0

# --- §22.12 environment hygiene -------------------------------------------
# dev | test | staging | production. The local KMS provider and the synthetic
# seeder both refuse to run outside dev/test.
ENVIRONMENT=dev

# --- §13 client-side field-level encryption --------------------------------
# Explicit CSFLE (works on Community mongo and Atlas alike). Off locally means
# plaintext, which is a dev-only state — anything past dev refuses to boot
# without it.
CSFLE_ENABLED=0
CSFLE_KMS_PROVIDER=local          # local (dev only) | aws
CSFLE_KEY_VAULT_NAMESPACE=__keyvault.datakeys
CSFLE_LOCAL_MASTER_KEY_PATH=.secrets/csfle-master.key
# CSFLE_AWS_KMS_KEY_ARN=arn:aws:kms:ap-south-1:...:key/...
# CSFLE_AWS_REGION=ap-south-1

# §30.6 — Stories are a P1 gated experiment; the collections are dark until this flips.
STORIES_ENABLED=0
