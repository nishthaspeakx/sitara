{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "screenshots": "playwright test --project=components --project=screens",
    "screenshots:update": "playwright test --project=components --project=screens --update-snapshots",
    "test": "playwright test --project=library",
    "test:screens": "playwright test --project=screens",
    "build:test": "NEXT_PUBLIC_AUTH_ADAPTER=fake NEXT_PUBLIC_DEVICE_FRAME=1 NEXT_PUBLIC_PROTOTYPE_CALLS=1 NEXT_PUBLIC_CEREMONY_DEADLINE_MS=1500 API_PROXY_TARGET=http://127.0.0.1:3101 NEXT_DIST_DIR=.next-test next build"
  },
  "dependencies": {
    "@sitara/i18n": "workspace:*",
    "@sitara/schemas": "workspace:*",
    "@sitara/tokens": "workspace:*",
    "firebase": "^12.17.1",
    "lucide-react": "^1.30.0",
    "next": "^15.3.0",
    "next-intl": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/nextjs": "^10.5.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "storybook": "^10.5.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
