# web — shape only, never real values (real values go in .env.local, git-ignored)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:8002

# Firebase client SDK config (§34.5 — client signs in, exchanges the ID token ONCE
# at POST /auth/session; the Firebase token never calls product APIs).
# These are public client identifiers, not secrets — but they still live in env, not code.
# Copy from Firebase console → Project settings → Your apps → Web app → firebaseConfig.
NEXT_PUBLIC_FIREBASE_API_KEY=copy-from-console
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=copy-from-console
NEXT_PUBLIC_FIREBASE_APP_ID=copy-from-console
