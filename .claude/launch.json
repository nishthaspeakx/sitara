{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/api",
        "uvicorn",
        "sitara_api.main:app",
        "--port",
        "8001",
        "--reload"
      ],
      "port": 8001
    },
    {
      "name": "realtime",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/realtime",
        "uvicorn",
        "sitara_realtime.main:app",
        "--port",
        "8002"
      ],
      "port": 8002
    },
    {
      "name": "astro",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/astro",
        "uvicorn",
        "sitara_astro.main:app",
        "--port",
        "8003",
        "--reload"
      ],
      "port": 8003
    }
  ]
}
