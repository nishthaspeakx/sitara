.DS_Store
node_modules/
__pycache__/
*.pyc

# Build artifacts (regenerated by turbo/next/uv; schemas' generated code IS committed)
.venv/
.next/
# Three Next output directories, one per mode — `next build` and `next dev`
# corrupt each other when they share one (apps/web/scripts/dist-dirs.mjs).
.next-dev/
.next-test/
# Regenerated by every `next` command, and it names whichever output directory
# ran last — so with three of them it is pure churn. A cold clone typechecks
# without it; `tests/dist-dirs.spec.ts` is what keeps the directories honest.
next-env.d.ts
.turbo/
dist/
*.tsbuildinfo
.pytest_cache/
.ruff_cache/

# Secrets — NEVER commit (CLAUDE.md non-negotiable; playbook §0.1/§1.3)
.env
.env.*
!.env.example
.secrets/
*service-account*.json

# Storybook + screenshot-suite outputs (§24.8 design-QA gate).
# The BASELINES under apps/web/tests/__screenshots__ ARE committed — they are
# the reviewable artefact; only the build and the run outputs are ignored.
storybook-static/
test-results/
playwright-report/

# `scripts/compare_voices.py` output — rendered audio for a human to play.
# Never committed: it is vendor output for a listening session, not a fixture,
# and re-rendering it is one command.
voice-compare/
voice-compare-*/
